# Senha única de acesso ao painel (não é usuário/senha por pessoa — 1 senha de admin)
ADMIN_PASSWORD=

# Banco NOVO deste projeto (Neon), só para dado de input manual (Caixa, Funil, etc.)
DATABASE_URL=

# Banco do DirectPro (Neon já existente) — SOMENTE LEITURA.
# Use uma connection string com um role read-only do Neon, se possível.
# NUNCA rode INSERT/UPDATE/DELETE contra esta variável.
DIRECTPRO_DATABASE_URL=
